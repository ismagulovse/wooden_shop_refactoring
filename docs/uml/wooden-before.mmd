classDiagram
    direction TB

    namespace Core {
        class Router["Маршрутизатор"]
        class BaseController["Базовый контроллер"]
        class BaseModel["Базовая модель"]
        class PDO["PDO — доступ к БД"]
    }

    namespace Store {
        class HomeController["Главная"]
        class CatalogController["Каталог"]
        class AuthController["Вход и регистрация"]
        class ProfileController["Личный кабинет"]
        class CartController["Корзина — страницы"]
        class FavoriteController["Избранное — страницы"]
        class CheckoutController["Оформление заказа"]
        class ErrorController["Страница ошибки"]
    }

    namespace Admin {
        class AdminBaseController["Основа админки"]
        class AdminDashboardController["Обзор магазина"]
        class AdminProductController["Управление товарами"]
        class AdminCategoryController["Управление категориями"]
        class AdminOrderController["Управление заказами"]
        class AdminUserController["Управление пользователями"]
    }

    namespace Models {
        class User["Пользователь"]
        class Product["Товар"]
        class Category["Категория"]
        class Order["Заказ"]
        class Cart["Корзина"]
        class Favorite["Избранное"]
    }

    namespace Pricing {
        class OrderPricing["Стоимость заказа"]
    }

    namespace Delivery {
        class CourierDelivery["Курьер"]
        class FreightDelivery["Перевозчик"]
    }

    namespace Packaging {
        class ProtectivePackaging["Защитная упаковка"]
        class CratePackaging["Короба"]
    }

    namespace Assembly {
        class WorkshopAssembly["Сборка в мастерской"]
        class OnSiteAssembly["Выездная сборка"]
    }

    namespace Discount {
        class LoyaltyDiscount["Скидка за сумму"]
        class BundleDiscount["Скидка за комплект"]
    }

    namespace Warranty {
        class ExtendedWarranty["Гарантия от стоимости"]
        class FixedWarranty["Фиксированная гарантия"]
    }

    namespace Recycling {
        class WeightRecycling["Вывоз по весу"]
        class ItemRecycling["Вывоз по количеству"]
    }

    <<abstract>> BaseController
    <<abstract>> BaseModel
    <<abstract>> AdminBaseController
    <<external>> PDO

    BaseController <|-- HomeController
    BaseController <|-- CatalogController
    BaseController <|-- AuthController
    BaseController <|-- ProfileController
    BaseController <|-- CartController
    BaseController <|-- FavoriteController
    BaseController <|-- CheckoutController
    BaseController <|-- ErrorController
    BaseController <|-- AdminBaseController
    AdminBaseController <|-- AdminDashboardController
    AdminBaseController <|-- AdminProductController
    AdminBaseController <|-- AdminCategoryController
    AdminBaseController <|-- AdminOrderController
    AdminBaseController <|-- AdminUserController
    BaseModel <|-- User
    BaseModel <|-- Product
    BaseModel <|-- Category
    BaseModel <|-- Order
    BaseModel <|-- Cart
    BaseModel <|-- Favorite

    BaseModel --> PDO : хранит соединение
    Router ..> BaseController : вызывает контроллеры
    Router ..> ErrorController : ошибка маршрута
    HomeController ..> Product
    HomeController ..> Category
    HomeController ..> Favorite
    CatalogController ..> Product
    CatalogController ..> Category
    CatalogController ..> Favorite
    AuthController ..> User
    ProfileController ..> User
    ProfileController ..> Order
    ProfileController ..> Favorite
    CartController ..> Cart
    FavoriteController ..> Favorite
    FavoriteController ..> Cart
    CheckoutController ..> Cart
    CheckoutController ..> User
    CheckoutController ..> Order
    CheckoutController ..> OrderPricing
    Order ..> OrderPricing
    Order ..> Cart
    AdminProductController ..> Product
    AdminProductController ..> Category
    AdminCategoryController ..> Category
    AdminOrderController ..> Order
    AdminUserController ..> User
    AdminUserController ..> PDO
    AdminDashboardController ..> PDO
    OrderPricing ..> CourierDelivery
    OrderPricing ..> FreightDelivery
    OrderPricing ..> ProtectivePackaging
    OrderPricing ..> CratePackaging
    OrderPricing ..> WorkshopAssembly
    OrderPricing ..> OnSiteAssembly
    OrderPricing ..> LoyaltyDiscount
    OrderPricing ..> BundleDiscount
    OrderPricing ..> ExtendedWarranty
    OrderPricing ..> FixedWarranty
    OrderPricing ..> WeightRecycling
    OrderPricing ..> ItemRecycling


